# ============================================================
# NEXUS SOCIAL — Environment Variables
# ============================================================
# Copy to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ============================================================
# DATABASE (Supabase PostgreSQL — Free Tier)
# ============================================================
# Project Settings → Database → Connection string
# Use "Transaction" mode (port 6543) for runtime (pooled):
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Use "Session" mode (port 5432) for migrations (direct):
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ============================================================
# OAUTH — GitHub
# ============================================================
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ============================================================
# OAUTH — Google
# ============================================================
# Create at: https://console.cloud.google.com
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================================
# CLOUDINARY (File Uploads — Free Tier)
# ============================================================
# Get from: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Create unsigned preset named "nexus-uploads" in your Cloudinary dashboard
CLOUDINARY_UPLOAD_PRESET="nexus-uploads"

# ============================================================
# BUILD (optional)
# ============================================================
# Set to "true" for Docker standalone build
# BUILD_STANDALONE="true"

# NODE_ENV is set automatically by Next.js (development/production)
